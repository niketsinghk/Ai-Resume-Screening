      "parameters": {
        "promptType": "define",
        "text": "=Candidate Resume:\n\n{{ $('Set Resume').item.json.resume }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You must analyze the candidate resume against the job description.\n\nReturn only valid JSON that matches the connected Structured Output Parser schema.\n\nDo not include markdown.\nDo not include code fences.\nDo not include explanations outside the JSON.\nDo not use headings like \"Candidate Strengths\" or \"Risk Factor\".\nThe final response must be a single JSON object only.\n\nFor risk_factor.score and reward_factor.score, use only one of:\nLow, Medium, High.\n\nFor overall_fit_rating, return an integer from 0 to 10 only.\n\nBase the evaluation only on the resume and job description. Do not invent experience or skills.\n\nJob Description:\n{{ $json.text }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1904,
        416
      ],
      "id": "ceb0935c-fea4-443c-9619-d4a7c5c77149",
